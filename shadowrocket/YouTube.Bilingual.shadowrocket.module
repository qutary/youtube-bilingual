#!name=YouTube Bilingual v2.1.0
#!desc=手机推荐与摘要翻译；四类接口自动优先关闭推理；BoxJS 配置。
#!author=qutary · derived from Maasea/sgmodule
#!homepage=https://github.com/qutary/youtube-bilingual

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

[Script]
YouTubeBilingualUI = type=http-response,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|reel\/reel_item_watch|guide|account\/get_setting|get_watch),requires-body=1,binary-body-mode=1,max-size=6500000,timeout=15,engine=webview,script-path=https://raw.githubusercontent.com/qutary/youtube-bilingual/dc4e9541f05b75755dd73fe47410ba747b99d3fd/shadowrocket/youtube-ui-adblock.js
YouTubeBilingualCaptions = type=http-response,pattern=^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?.*)?$|^https:\/\/video\.google\.com\/timedtext(?:\?.*)?$,requires-body=1,binary-body-mode=0,max-size=6500000,timeout=35,engine=webview,script-path=https://raw.githubusercontent.com/qutary/youtube-bilingual/dc4e9541f05b75755dd73fe47410ba747b99d3fd/shadowrocket/youtube-bilingual.shadowrocket.js

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,m.youtube.com,music.youtube.com,video.google.com,s.youtube.com,youtubei.googleapis.com
