#!name=YouTube Bilingual Subtitles · Shadowrocket
#!desc=YouTube 原生 App 中英双语/仅中文字幕；支持 DeepSeek、火山方舟、OpenRouter 和自定义 OpenAI 兼容接口。Preview 1。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles
#!arguments=启用翻译:true, 字幕模式:bilingual, 翻译平台:deepseek, DeepSeekKey:, DeepSeekModel:deepseek-flash, DeepSeekEndpoint:https://api.deepseek.com/chat/completions, DeepSeek并发:20, 火山Key:, 火山Model:, 火山Endpoint:https://ark.cn-beijing.volces.com/api/v3/chat/completions, 火山并发:10, 火山Fast:false, 火山Compact:false, 火山LongFast:true, OpenRouterKey:, OpenRouterModel:, OpenRouterEndpoint:https://openrouter.ai/api/v1/chat/completions, OpenRouter并发:10, OpenRouterCompact:false, OpenRouterReasoning:auto, OpenRouterFastStart:true, OpenRouterSort:auto, CustomKey:, CustomModel:, CustomEndpoint:, JSONMode:auto, BypassCache:false, CacheEpoch:1, ResponseBudget:6.3, LongAdaptive:true, LongAlignedReliable:true, LongStartFour:true
#!arguments-desc=启用翻译：关闭后原样返回英文字幕。\n字幕模式：bilingual=中文在上、英文在下；translation=仅中文。\n翻译平台：deepseek、volcengine、openrouter、custom。只需填写当前选择平台的 API Key 和模型；其他平台配置会保留。\n并发：DeepSeek 1–256，火山方舟和 OpenRouter 1–256；高并发会增加 API 请求量。\nResponseBudget：3–30 秒，默认 6.3；等待过长可能导致 YouTube 放弃加载。\nJSONMode：auto/on/off；BypassCache：仅调试时开启。API Key 仅保存在本机模块参数中，请勿分享包含密钥的配置。
 
[Script]
YouTubeBilingualSubtitles = type=http-response,pattern=^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?.*)?$|^https:\/\/video\.google\.com\/timedtext(?:\?.*)?$,requires-body=true,max-size=2097152,timeout=35,engine=webview,script-path=https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/main/shadowrocket/youtube-bilingual.shadowrocket.js?v=0.1.0-preview.1,argument="{"启用翻译":"{{{启用翻译}}}","字幕模式":"{{{字幕模式}}}","翻译平台":"{{{翻译平台}}}","DeepSeekKey":"{{{DeepSeekKey}}}","DeepSeekModel":"{{{DeepSeekModel}}}","DeepSeekEndpoint":"{{{DeepSeekEndpoint}}}","DeepSeek并发":"{{{DeepSeek并发}}}","火山Key":"{{{火山Key}}}","火山Model":"{{{火山Model}}}","火山Endpoint":"{{{火山Endpoint}}}","火山并发":"{{{火山并发}}}","火山Fast":"{{{火山Fast}}}","火山Compact":"{{{火山Compact}}}","火山LongFast":"{{{火山LongFast}}}","OpenRouterKey":"{{{OpenRouterKey}}}","OpenRouterModel":"{{{OpenRouterModel}}}","OpenRouterEndpoint":"{{{OpenRouterEndpoint}}}","OpenRouter并发":"{{{OpenRouter并发}}}","OpenRouterCompact":"{{{OpenRouterCompact}}}","OpenRouterReasoning":"{{{OpenRouterReasoning}}}","OpenRouterFastStart":"{{{OpenRouterFastStart}}}","OpenRouterSort":"{{{OpenRouterSort}}}","CustomKey":"{{{CustomKey}}}","CustomModel":"{{{CustomModel}}}","CustomEndpoint":"{{{CustomEndpoint}}}","JSONMode":"{{{JSONMode}}}","BypassCache":"{{{BypassCache}}}","CacheEpoch":"{{{CacheEpoch}}}","ResponseBudget":"{{{ResponseBudget}}}","LongAdaptive":"{{{LongAdaptive}}}","LongAlignedReliable":"{{{LongAlignedReliable}}}","LongStartFour":"{{{LongStartFour}}}"}"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, music.youtube.com, video.google.com
