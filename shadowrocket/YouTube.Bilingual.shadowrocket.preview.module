#!name=YouTube Bilingual Subtitles · Shadowrocket Preview
#!desc=YouTube 原生 App 中英双语/仅中文字幕；支持 DeepSeek、火山方舟、OpenRouter 和自定义 OpenAI 兼容接口。Preview 4。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles
#!arguments=启用翻译:true, 仅显示中文字幕:false, 使用火山方舟:false, 使用OpenRouter:false, 使用自定义API:false, DeepSeekKey:PASTE_API_KEY_HERE, DeepSeekModel:deepseek-flash, DeepSeekEndpoint:https://api.deepseek.com/chat/completions, DeepSeek并发:20, 火山Key:PASTE_API_KEY_HERE, 火山Model:ENTER_MODEL_ID, 火山Endpoint:https://ark.cn-beijing.volces.com/api/v3/chat/completions, 火山并发:10, 火山Fast:false, 火山Compact:false, 火山LongFast:true, OpenRouterKey:PASTE_API_KEY_HERE, OpenRouterModel:ENTER_MODEL_ID, OpenRouterEndpoint:https://openrouter.ai/api/v1/chat/completions, OpenRouter并发:10, OpenRouterCompact:false, OpenRouterReasoning:auto, OpenRouterFastStart:true, OpenRouterSort:auto, CustomKey:PASTE_API_KEY_HERE, CustomModel:ENTER_MODEL_ID, CustomEndpoint:https://example.invalid/v1/chat/completions, JSONMode:auto, BypassCache:false, CacheEpoch:1, ResponseBudget:6.3, LongAdaptive:true, LongAlignedReliable:true, LongStartFour:true
#!arguments-desc=启用翻译：关闭后直接返回原始字幕。\n默认使用 DeepSeek。选择火山方舟、OpenRouter 或自定义 API 时，只打开对应的一个开关；不要同时打开多个。\nDeepSeekKey/火山Key/OpenRouterKey/CustomKey：将 PASTE_API_KEY_HERE 改成自己的真实 API Key；其他平台无需填写。\n仅显示中文字幕：关闭=中英双语（中文在上、英文在下）；开启=仅显示中文字幕。\n火山Model/OpenRouterModel/CustomModel：替换 ENTER_MODEL_ID 为实际模型 ID；CustomEndpoint 需要替换示例域名。\n并发数 1–64；ResponseBudget 3–30 秒，默认 6.3。\nJSONMode=auto/on/off；BypassCache 仅在排障时启用。\nAPI Key 仅保存在自己的 Shadowrocket 配置里，请勿分享含 Key 的截图、模块导出或日志。
 
[Script]
YouTubeBilingualSubtitles = type=http-response,pattern=^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?.*)?$|^https:\/\/video\.google\.com\/timedtext(?:\?.*)?$,requires-body=true,max-size=2097152,timeout=35,engine=webview,script-path=https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/feature/shadowrocket-support/shadowrocket/youtube-bilingual.shadowrocket.js?v=0.1.0-preview.4,argument="启用翻译={{{启用翻译}}}&仅显示中文字幕={{{仅显示中文字幕}}}&使用火山方舟={{{使用火山方舟}}}&使用OpenRouter={{{使用OpenRouter}}}&使用自定义API={{{使用自定义API}}}&DeepSeekKey={{{DeepSeekKey}}}&DeepSeekModel={{{DeepSeekModel}}}&DeepSeekEndpoint={{{DeepSeekEndpoint}}}&DeepSeek并发={{{DeepSeek并发}}}&火山Key={{{火山Key}}}&火山Model={{{火山Model}}}&火山Endpoint={{{火山Endpoint}}}&火山并发={{{火山并发}}}&火山Fast={{{火山Fast}}}&火山Compact={{{火山Compact}}}&火山LongFast={{{火山LongFast}}}&OpenRouterKey={{{OpenRouterKey}}}&OpenRouterModel={{{OpenRouterModel}}}&OpenRouterEndpoint={{{OpenRouterEndpoint}}}&OpenRouter并发={{{OpenRouter并发}}}&OpenRouterCompact={{{OpenRouterCompact}}}&OpenRouterReasoning={{{OpenRouterReasoning}}}&OpenRouterFastStart={{{OpenRouterFastStart}}}&OpenRouterSort={{{OpenRouterSort}}}&CustomKey={{{CustomKey}}}&CustomModel={{{CustomModel}}}&CustomEndpoint={{{CustomEndpoint}}}&JSONMode={{{JSONMode}}}&BypassCache={{{BypassCache}}}&CacheEpoch={{{CacheEpoch}}}&ResponseBudget={{{ResponseBudget}}}&LongAdaptive={{{LongAdaptive}}}&LongAlignedReliable={{{LongAlignedReliable}}}&LongStartFour={{{LongStartFour}}}"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, music.youtube.com, video.google.com
