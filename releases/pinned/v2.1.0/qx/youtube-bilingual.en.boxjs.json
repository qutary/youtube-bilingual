      "settings": [
        {
          "id": "QXYTB_BETA_DEEPSEEK_KEY",
          "name": "API Key",
          "type": "text",
          "val": "",
          "desc": "Enter your provider's API key.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_MODEL",
          "name": "Model ID",
          "type": "text",
          "val": "deepseek-flash",
          "desc": "Enter a model ID supported by this API.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_CONCURRENCY",
          "name": "Concurrent requests",
          "type": "text",
          "val": "20",
          "desc": "Integer 1–256; default 20. Lower it if rate-limited.",
          "inputmode": "numeric",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_ENDPOINT",
          "name": "API endpoint (optional)",
          "type": "text",
          "val": "https://api.deepseek.com/chat/completions",
          "desc": "Keep the default, or enter a full HTTPS endpoint.",
          "persistent-hint": true,
          "hide-details": false
