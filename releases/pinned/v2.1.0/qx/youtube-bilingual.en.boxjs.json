{
  "id": "qutary.youtube-bilingual.shared.en",
  "name": "YouTube Bilingual v2.1.0 (English)",
  "author": "@qutary",
  "description": "Shared settings for Quantumult X and Shadowrocket",
  "repo": "https://github.com/qutary/youtube-bilingual",
  "apps": [
    {
      "id": "qutary.youtube-bilingual.langpair-v5.common.en",
      "name": "🎬 Caption settings",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual",
      "keys": [
        "QXYTB_BETA_ENABLED",
        "QXYTB_BETA_DISPLAY",
        "QXYTB_BETA_SOURCE_LANG",
        "QXYTB_BETA_TARGET_LANG",
        "QXYTB_BETA_PROVIDER",
        "QXYTB_BETA_RESPONSE_BUDGET",
        "QXYTB_BETA_LONG_ADAPTIVE",
        "QXYTB_BETA_LONG_START_FOUR",
        "QXYTB_BETA_LONG_ALIGNED_RELIABLE",
        "QXYTB_BETA_JSON_MODE",
        "QXYTB_BETA_BYPASS_CACHE",
        "QXYTB_BETA_CACHE_EPOCH"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_ENABLED",
          "name": "Translate video captions",
          "type": "boolean",
          "val": true,
          "desc": "Only affects video captions.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_DISPLAY",
          "name": "Text display mode",
          "type": "selects",
          "val": "bilingual",
          "items": [
            {
              "key": "bilingual",
              "label": "Bilingual: translation above original"
            },
            {
              "key": "source_first",
              "label": "Bilingual: original above translation"
            },
            {
              "key": "translation",
              "label": "Translation only"
            }
          ]
        },
        {
          "id": "QXYTB_BETA_SOURCE_LANG",
          "name": "Caption source language",
          "type": "selects",
          "val": "auto",
          "items": [
            {
              "key": "auto",
              "label": "Auto-detect"
            },
            {
              "key": "zh",
              "label": "Chinese"
            },
            {
              "key": "en",
              "label": "English"
            },
            {
              "key": "ja",
              "label": "Japanese"
            },
            {
              "key": "ko",
              "label": "Korean"
            },
            {
              "key": "fr",
              "label": "French"
            },
            {
              "key": "ru",
              "label": "Russian"
            },
            {
              "key": "de",
              "label": "German"
            },
            {
              "key": "pt",
              "label": "Portuguese"
            },
            {
              "key": "es",
              "label": "Spanish"
            },
            {
              "key": "it",
              "label": "Italian"
            },
            {
              "key": "hi",
              "label": "Hindi"
            },
            {
              "key": "th",
              "label": "Thai"
            },
            {
              "key": "ar",
              "label": "Arabic"
            }
          ]
        },
        {
          "id": "QXYTB_BETA_TARGET_LANG",
          "name": "Target language",
          "type": "selects",
          "val": "zh",
          "items": [
            {
              "key": "zh",
              "label": "Chinese"
            },
            {
              "key": "en",
              "label": "English"
            },
            {
              "key": "ja",
              "label": "Japanese"
            },
            {
              "key": "ko",
              "label": "Korean"
            },
            {
              "key": "fr",
              "label": "French"
            },
            {
              "key": "ru",
              "label": "Russian"
            },
            {
              "key": "de",
              "label": "German"
            },
            {
              "key": "pt",
              "label": "Portuguese"
            },
            {
              "key": "es",
              "label": "Spanish"
            },
            {
              "key": "it",
              "label": "Italian"
            },
            {
              "key": "hi",
              "label": "Hindi"
            },
            {
              "key": "th",
              "label": "Thai"
            },
            {
              "key": "ar",
              "label": "Arabic"
            }
          ],
          "desc": "Used for captions and interface text.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_PROVIDER",
          "name": "Translation service",
          "type": "selects",
          "val": "deepseek",
          "items": [
            {
              "key": "deepseek",
              "label": "DeepSeek"
            },
            {
              "key": "volcengine",
              "label": "Volcengine Ark"
            },
            {
              "key": "openrouter",
              "label": "OpenRouter"
            },
            {
              "key": "custom",
              "label": "Custom OpenAI-compatible API"
            }
          ],
          "desc": "Captions and interface use the selected service; no cross-service fallback.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_RESPONSE_BUDGET",
          "name": "Caption wait budget (seconds)",
          "type": "text",
          "val": "6.3",
          "desc": "3–10 s; default 6.3. Caption processing limit.",
          "inputmode": "decimal",
          "min": 3,
          "max": 10,
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_LONG_ADAPTIVE",
          "name": "Advanced: adaptive long-video batches",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_LONG_START_FOUR",
          "name": "Advanced: 4-unit long-video start",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_LONG_ALIGNED_RELIABLE",
          "name": "Advanced: reliable long-sentence splitting",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_JSON_MODE",
          "name": "Advanced: JSON response mode",
          "desc": "Shared by captions and interface; turn off if unsupported.",
          "type": "selects",
          "val": "auto",
          "items": [
            {
              "key": "auto",
              "label": "Auto (service preset)"
            },
            {
              "key": "on",
              "label": "On: request JSON object responses"
            },
            {
              "key": "off",
              "label": "Off: omit response_format"
            }
          ]
        },
        {
          "id": "QXYTB_BETA_BYPASS_CACHE",
          "name": "Advanced: bypass translation cache",
          "type": "boolean",
          "val": false
        },
        {
          "id": "QXYTB_BETA_CACHE_EPOCH",
          "name": "Advanced: cache version",
          "type": "text",
          "val": "1",
          "desc": "Changing this invalidates old caption cache. Usually leave unchanged.",
          "persistent-hint": true,
          "hide-details": false
        }
      ]
    },
    {
      "name": "🪟 Interface translation",
      "settings": [
        {
          "id": "QXYTB_BETA_UI_ENABLED",
          "name": "Translate interface text",
          "type": "boolean",
          "val": true,
          "desc": "Turning off keeps captions and ad filtering active. Channel names, view counts and dates stay unchanged.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_UI_HOME",
          "name": "Home, search and channels",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_WATCH",
          "name": "Watch page and recommendations",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_DESCRIPTION",
          "name": "Video descriptions",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_SHORTS",
          "name": "Shorts",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_COMMENTS",
          "name": "Comments and replies",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_CHANNEL",
          "name": "Channel descriptions",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_POSTS",
          "name": "Community posts",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_PLAYLIST",
          "name": "Playlists and descriptions",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_UI_HISTORY",
          "name": "Watch history list",
          "type": "boolean",
          "val": true
        },
        {
          "id": "QXYTB_BETA_CLEAR_ALL_CACHE",
          "name": "Clear all translation cache (once)",
          "type": "boolean",
          "val": false,
          "desc": "Runs on the next YouTube request, then resets. Keeps keys and settings.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_UI_CACHE",
          "name": "Interface cache (current language)",
          "type": "selects",
          "val": "on",
          "items": [
            {
              "key": "on",
              "label": "On"
            },
            {
              "key": "off",
              "label": "Off"
            },
            {
              "key": "clear",
              "label": "Clear current language"
            }
          ],
          "desc": "After clearing, switch back to On.",
          "persistent-hint": true,
          "hide-details": false
        },
        {
          "id": "QXYTB_BETA_UI_CONTENT_CACHE",
          "name": "Comment/description cache (current language)",
          "type": "selects",
          "val": "on",
          "items": [
            {
              "key": "on",
              "label": "On"
            },
            {
              "key": "off",
              "label": "Off"
            },
            {
              "key": "clear",
              "label": "Clear current language"
            }
          ],
          "desc": "After clearing, switch back to On.",
          "persistent-hint": true,
          "hide-details": false
        }
      ],
      "id": "qutary.youtube-bilingual.beta2.ui-category.en",
      "keys": [
        "QXYTB_BETA_UI_ENABLED",
        "QXYTB_BETA_UI_HOME",
        "QXYTB_BETA_UI_WATCH",
        "QXYTB_BETA_UI_DESCRIPTION",
        "QXYTB_BETA_UI_SHORTS",
