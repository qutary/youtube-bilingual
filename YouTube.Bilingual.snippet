#!name=YouTube Bilingual Subtitles · 中文意群预览版
#!desc=仅识别出的原生iOS YouTube生效，浏览器和未知请求原样放行。先接回跨屏句子，再翻译并按中文意群分屏；涉及局部估时、独立缓存和额外token开销，需实机验证。与正式订阅二选一启用。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles/tree/preview-semantic-v1

# 预览版会重新翻译语义单元；正式版保留但暂时停用，勿同时启用。
hostname = www.youtube.com, m.youtube.com, music.youtube.com, video.google.com

^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-semantic-v1/youtube-bilingual.js?v=SemanticPreview.1
^https:\/\/video\.google\.com\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-semantic-v1/youtube-bilingual.js?v=SemanticPreview.1
