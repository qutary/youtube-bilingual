# 独立测试分支；只启用一份YouTube字幕重写。无需清理Key或译文缓存。
hostname = www.youtube.com, m.youtube.com, music.youtube.com, video.google.com

^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-longwait-v1/youtube-bilingual.js?v=LongWaitPreview.1
^https:\/\/video\.google\.com\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-longwait-v1/youtube-bilingual.js?v=LongWaitPreview.1
