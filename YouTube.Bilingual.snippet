#!desc=修复旧8秒回调提前结束和整轨门槛隐藏中文：已完成中文保留，缺失部分留英文；改进短语失败重试。DeepSeek专用、8/15秒脚本目标，原生等待仍待验证。与其他字幕订阅二选一。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles/tree/preview-longwait-v1

# 更新同一长等待测试订阅及脚本；只启用一份字幕重写。无需清理Key或缓存。
hostname = www.youtube.com, m.youtube.com, music.youtube.com, video.google.com

^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-longwait-v1/youtube-bilingual.js?v=LongWaitPreview.2
^https:\/\/video\.google\.com\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/preview-longwait-v1/youtube-bilingual.js?v=LongWaitPreview.2
