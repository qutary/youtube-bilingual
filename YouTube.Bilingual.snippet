#!name=YouTube Bilingual Subtitles
#!desc=YouTube 原生 App 双语/中文字幕；支持 DeepSeek、火山方舟、OpenRouter 与自定义 API，使用 BoxJS 配置。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles

# 只启用这一份 YouTube 字幕重写；在 BoxJS 配置 API Key。
hostname = www.youtube.com, m.youtube.com, music.youtube.com, video.google.com

^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/main/youtube-bilingual.js?v=1.5.0
^https:\/\/video\.google\.com\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/main/youtube-bilingual.js?v=1.5.0
