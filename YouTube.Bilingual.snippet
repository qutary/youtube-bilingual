#!name=YouTube Bilingual Subtitles · DeepSeek
#!desc=在 iPad 原生 YouTube 中显示 DeepSeek 翻译的中英双语字幕：中文在上、英文在下；支持自适应并发、8秒翻译预算、缓存补翻。需自备 DeepSeek API Key，长视频不保证一次全量翻译。
#!author=qutary
#!homepage=https://github.com/qutary/youtube-bilingual-subtitles

# Quantumult X → 重写 → 引用：只启用这一条订阅
hostname = www.youtube.com, m.youtube.com, music.youtube.com, video.google.com

^https:\/\/(?:www|m|music)\.youtube\.com\/api\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/main/youtube-bilingual.js
^https:\/\/video\.google\.com\/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/qutary/youtube-bilingual-subtitles/main/youtube-bilingual.js
