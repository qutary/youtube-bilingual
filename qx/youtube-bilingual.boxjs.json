{
  "id": "qutary.youtube-bilingual.boxjs-preview-v1.sub",
  "name": "YouTube Bilingual Subtitles · BoxJS",
  "author": "@qutary",
  "description": "YouTube 原生 App 字幕翻译：按常用设置、平台及高级选项分开配置",
  "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
  "apps": [
    {
      "id": "qutary.youtube-bilingual.boxjs-preview-v1",
      "name": "🎬 YouTube 双语字幕 · 常用设置",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
      "descs_html": [
        "首先设置字幕模式和翻译平台。默认使用 DeepSeek，直接在下方填写 API Key。",
        "火山方舟、OpenRouter 和自定义 API 请进入本订阅对应配置页；保存后重新进入视频生效。",
        "<a href=\"https://github.com/qutary/youtube-bilingual-subtitles#-快速安装\">安装与使用指南</a>"
      ],
      "keys": [
        "QXYTB_BETA_ENABLED",
        "QXYTB_BETA_DISPLAY",
        "QXYTB_BETA_PROVIDER",
        "QXYTB_BETA_DEEPSEEK_KEY",
        "QXYTB_BETA_DEEPSEEK_MODEL",
        "QXYTB_BETA_DEEPSEEK_ENDPOINT",
        "QXYTB_BETA_DEEPSEEK_CONCURRENCY",
        "QXYTB_BETA_VOLCENGINE_KEY",
        "QXYTB_BETA_VOLCENGINE_MODEL",
        "QXYTB_BETA_VOLCENGINE_ENDPOINT",
        "QXYTB_BETA_VOLCENGINE_CONCURRENCY",
        "QXYTB_BETA_VOLCENGINE_FAST",
        "QXYTB_BETA_VOLCENGINE_COMPACT_BATCH",
        "QXYTB_BETA_VOLCENGINE_LONG_FAST_START",
        "QXYTB_BETA_OPENROUTER_KEY",
        "QXYTB_BETA_OPENROUTER_MODEL",
        "QXYTB_BETA_OPENROUTER_ENDPOINT",
        "QXYTB_BETA_OPENROUTER_CONCURRENCY",
        "QXYTB_BETA_OPENROUTER_COMPACT_BATCH",
        "QXYTB_BETA_OPENROUTER_REASONING",
        "QXYTB_BETA_OPENROUTER_FAST_START",
        "QXYTB_BETA_LONG_ADAPTIVE",
        "QXYTB_BETA_LONG_START_FOUR",
        "QXYTB_BETA_LONG_ALIGNED_RELIABLE",
        "QXYTB_BETA_OPENROUTER_SORT",
        "QXYTB_BETA_CUSTOM_KEY",
        "QXYTB_BETA_CUSTOM_MODEL",
        "QXYTB_BETA_CUSTOM_ENDPOINT",
        "QXYTB_BETA_JSON_MODE",
        "QXYTB_BETA_BYPASS_CACHE",
        "QXYTB_BETA_CACHE_EPOCH",
        "QXYTB_BETA_RESPONSE_BUDGET"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_ENABLED",
          "name": "开启字幕翻译",
          "type": "boolean",
          "val": true,
          "desc": "关闭时保留原字幕，不请求翻译 API。"
        },
        {
          "id": "QXYTB_BETA_DISPLAY",
          "name": "字幕显示方式",
          "type": "selects",
          "val": "bilingual",
          "items": [
            {
              "key": "bilingual",
              "label": "双语：中文在上、英文在下"
            },
            {
              "key": "translation",
              "label": "仅译文：只显示中文"
            }
          ],
          "desc": "双语时中文在上、英文在下；未完成翻译的片段保留英文。"
        },
        {
          "id": "QXYTB_BETA_PROVIDER",
          "name": "翻译平台",
          "type": "selects",
          "val": "deepseek",
          "items": [
            {
              "key": "deepseek",
              "label": "DeepSeek"
            },
            {
              "key": "volcengine",
              "label": "火山方舟"
            },
            {
              "key": "openrouter",
              "label": "OpenRouter"
            },
            {
              "key": "custom",
              "label": "自定义 OpenAI 兼容接口 / 中转站"
            }
          ],
          "desc": "默认 DeepSeek；使用其他平台时，在对应服务配置页面填写密钥。"
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_KEY",
          "name": "DeepSeek · API Key",
          "type": "text",
          "val": "",
          "desc": "只保存在自己的本机配置，不要公开密钥或包含密钥的截图。"
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_MODEL",
          "name": "DeepSeek · 模型 ID",
          "type": "text",
          "val": "deepseek-flash",
          "desc": "默认 deepseek-flash，可替换为实际支持的模型。"
        },
        {
          "id": "QXYTB_BETA_RESPONSE_BUDGET",
          "name": "字幕等待时间（秒）",
          "type": "text",
          "val": "6.3",
          "desc": "默认 6.3 秒，范围 3–30 秒；等待过长可能导致播放器提前结束加载。"
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_CONCURRENCY",
          "name": "DeepSeek · 并发数",
          "type": "text",
          "val": "20",
          "desc": "默认 20，范围 1–256；并发越高不一定越快。"
        },
        {
          "id": "QXYTB_BETA_DEEPSEEK_ENDPOINT",
          "name": "DeepSeek · API 地址（可选）",
          "type": "text",
          "val": "https://api.deepseek.com/chat/completions",
          "desc": "保持默认即可；仅自定义服务地址时修改。"
        }
      ]
    },
    {
      "id": "qutary.youtube-bilingual.boxjs.volcengine",
      "name": "🌋 火山方舟 · 服务配置",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
      "descs_html": [
        "在「常用设置」选择火山方舟后，填写此处的 API Key 和模型 / 接入点 ID。",
        "性能选项通常保留默认即可。"
      ],
      "keys": [
        "QXYTB_BETA_VOLCENGINE_KEY",
        "QXYTB_BETA_VOLCENGINE_MODEL",
        "QXYTB_BETA_VOLCENGINE_CONCURRENCY",
        "QXYTB_BETA_VOLCENGINE_ENDPOINT",
        "QXYTB_BETA_VOLCENGINE_FAST",
        "QXYTB_BETA_VOLCENGINE_COMPACT_BATCH",
        "QXYTB_BETA_VOLCENGINE_LONG_FAST_START"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_VOLCENGINE_KEY",
          "name": "API Key",
          "type": "text",
          "val": "",
          "desc": "在本机填写，勿公开。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_MODEL",
          "name": "模型 / 接入点 ID",
          "type": "text",
          "val": "",
          "desc": "填写模型或接入点 ID。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_CONCURRENCY",
          "name": "并发数",
          "type": "text",
          "val": "10",
          "desc": "1–256 整数，默认 10。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_ENDPOINT",
          "name": "API 地址（可选）",
          "type": "text",
          "val": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
          "desc": "留空使用默认 HTTPS 地址。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_FAST",
          "name": "低延迟模式",
          "type": "boolean",
          "val": false,
          "desc": "默认关闭；部分接口不支持 fast。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_COMPACT_BATCH",
          "name": "使用短批次",
          "type": "boolean",
          "val": false,
          "desc": "低并发可手动开启；高于 20 并发自动使用。"
        },
        {
          "id": "QXYTB_BETA_VOLCENGINE_LONG_FAST_START",
          "name": "长视频快速启动",
          "type": "boolean",
          "val": true,
          "desc": "超长视频首轮最多 24 并发。"
        }
      ]
    },
    {
      "id": "qutary.youtube-bilingual.boxjs.openrouter",
      "name": "🌐 OpenRouter · 服务配置",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
      "descs_html": [
        "在「常用设置」选择 OpenRouter 后，填写此处的 API Key 和完整模型 ID。",
        "推理强度、路由和批次参数通常保留默认即可。"
      ],
      "keys": [
        "QXYTB_BETA_OPENROUTER_KEY",
        "QXYTB_BETA_OPENROUTER_MODEL",
        "QXYTB_BETA_OPENROUTER_CONCURRENCY",
        "QXYTB_BETA_OPENROUTER_ENDPOINT",
        "QXYTB_BETA_OPENROUTER_REASONING",
        "QXYTB_BETA_OPENROUTER_SORT",
        "QXYTB_BETA_OPENROUTER_COMPACT_BATCH",
        "QXYTB_BETA_OPENROUTER_FAST_START"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_OPENROUTER_KEY",
          "name": "API Key",
          "type": "text",
          "val": "",
          "desc": "在本机填写，勿公开。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_MODEL",
          "name": "模型 ID（含提供商前缀）",
          "type": "text",
          "val": "",
          "desc": "填写含提供商前缀的模型 ID。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_CONCURRENCY",
          "name": "并发数",
          "type": "text",
          "val": "10",
          "desc": "1–256 整数，默认 10。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_ENDPOINT",
          "name": "API 地址（可选）",
          "type": "text",
          "val": "https://openrouter.ai/api/v1/chat/completions",
          "desc": "留空使用默认 HTTPS 地址。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_REASONING",
          "name": "模型推理强度",
          "type": "selects",
          "val": "auto",
          "items": [
            {
              "key": "auto",
              "label": "自动：GPT-6 Luna 关闭思考，其他模型保持默认"
            },
            {
              "key": "none",
              "label": "none · 完全关闭推理（低延迟）"
            },
            {
              "key": "low",
              "label": "low · 低推理强度"
            },
            {
              "key": "medium",
              "label": "medium · 中等推理强度"
            }
          ],
          "desc": "auto 对 GPT-6 Luna 关闭额外思考；其他模型保持默认。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_SORT",
          "name": "路由偏好",
          "type": "selects",
          "val": "auto",
          "items": [
            {
              "key": "auto",
              "label": "自动（默认）"
            },
            {
              "key": "latency",
              "label": "低延迟优先"
            },
            {
              "key": "throughput",
              "label": "高吞吐优先"
            }
          ],
          "desc": "选择自动、低延迟或高吞吐路由。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_COMPACT_BATCH",
          "name": "使用短批次",
          "type": "boolean",
          "val": false,
          "desc": "低并发可手动开启；高于 20 并发自动使用。"
        },
        {
          "id": "QXYTB_BETA_OPENROUTER_FAST_START",
          "name": "快速启动",
          "type": "boolean",
          "val": true,
          "desc": "高并发时首轮最多 32 个请求。"
        }
      ]
    },
    {
      "id": "qutary.youtube-bilingual.boxjs.custom",
      "name": "🔌 自定义 API · 服务配置",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
      "descs_html": [
        "在「常用设置」选择自定义 API 后，填写 API Key、模型 ID 和完整 HTTPS Chat Completions 地址。"
      ],
      "keys": [
        "QXYTB_BETA_CUSTOM_KEY",
        "QXYTB_BETA_CUSTOM_MODEL",
        "QXYTB_BETA_CUSTOM_ENDPOINT"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_CUSTOM_KEY",
          "name": "API Key",
          "type": "text",
          "val": "",
          "desc": "在本机填写，勿公开。"
        },
        {
          "id": "QXYTB_BETA_CUSTOM_MODEL",
          "name": "模型 ID",
          "type": "text",
          "val": "",
          "desc": "填写接口支持的模型 ID。"
        },
        {
          "id": "QXYTB_BETA_CUSTOM_ENDPOINT",
          "name": "API 地址",
          "type": "text",
          "val": "",
          "desc": "必须填写完整 HTTPS Chat Completions 地址。"
        }
      ]
    },
    {
      "id": "qutary.youtube-bilingual.boxjs.advanced",
      "name": "⚙️ 高级设置 · 长视频与缓存",
      "author": "@qutary",
      "repo": "https://github.com/qutary/youtube-bilingual-subtitles",
      "descs_html": [
        "日常使用不需要修改这里；建议保持默认设置。",
        "改变缓存和分批参数可能影响翻译成本与字幕加载成功率。"
      ],
      "keys": [
        "QXYTB_BETA_LONG_ADAPTIVE",
        "QXYTB_BETA_LONG_START_FOUR",
        "QXYTB_BETA_LONG_ALIGNED_RELIABLE",
        "QXYTB_BETA_JSON_MODE",
        "QXYTB_BETA_BYPASS_CACHE",
        "QXYTB_BETA_CACHE_EPOCH"
      ],
      "settings": [
        {
          "id": "QXYTB_BETA_LONG_ADAPTIVE",
          "name": "长视频 · 自适应批次",
          "type": "boolean",
          "val": true,
          "desc": "超长视频按响应耗时自动调整翻译批次。"
        },
        {
          "id": "QXYTB_BETA_LONG_START_FOUR",
          "name": "长视频 · 4 单元起步",
          "type": "boolean",
          "val": true,
          "desc": "短句为主的长视频从 4 单元起步，可自动降档。"
        },
        {
          "id": "QXYTB_BETA_LONG_ALIGNED_RELIABLE",
          "name": "长句 · 可靠分段",
          "type": "boolean",
          "val": true,
          "desc": "长句首次独立分段，降低对齐失败。"
        },
        {
          "id": "QXYTB_BETA_JSON_MODE",
          "name": "JSON 输出模式",
          "type": "selects",
          "val": "auto",
          "items": [
            {
              "key": "auto",
              "label": "自动：按平台预设"
            },
            {
              "key": "on",
              "label": "开启：发送 response_format=json_object"
            },
            {
              "key": "off",
              "label": "关闭：省略 response_format"
            }
          ],
          "desc": "兼容接口拒绝 JSON 模式时可关闭。"
        },
        {
          "id": "QXYTB_BETA_BYPASS_CACHE",
          "name": "绕过译文缓存（仅调试）",
          "type": "boolean",
          "val": false,
          "desc": "仅用于测试；日常请关闭，避免重复计费。"
        },
        {
          "id": "QXYTB_BETA_CACHE_EPOCH",
          "name": "缓存版本（谨慎修改）",
          "type": "text",
          "val": "1",
          "desc": "通常保持 1；更改后旧译文可能无法复用。"
        }
      ]
    }
  ]
}
